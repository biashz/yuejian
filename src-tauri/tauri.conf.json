{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YueJian Reader",
  "version": "0.1.13",
  "identifier": "com.yuejian.reader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "PDF 与 Markdown 本地阅读器",
    "longDescription": "阅笺是一款本地优先的 PDF 与 Markdown 阅读器，书架、阅读进度与偏好设置全部保存在安装目录内。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
